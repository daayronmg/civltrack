# Copia a .env y ajusta. NUNCA subas .env al repositorio.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL con PostGIS
DATABASE_URL=postgres://gasgo:CAMBIA_ESTO@localhost:5432/gasgo
DATABASE_POOL_MAX=10

# Fuente oficial (MITECO). Normalmente no hay que tocar nada.
# GASGO_SOURCE_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes/EstacionesTerrestres/
# GASGO_SOURCE_MIRROR_URL=https://energia.serviciosmin.gob.es/ServiciosRestCarburantes/PreciosCarburantes/EstacionesTerrestres/
GASGO_SOURCE_TIMEOUT_MS=120000
GASGO_SOURCE_RETRIES=3
GASGO_USER_AGENT=GASGO/1.0 (comparador de precios de carburante; contacto: TU_CORREO)

# Límites de la API
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
DEVICE_REGISTRATIONS_PER_HOUR=30
MAX_STATIONS_PER_QUERY=200
MAX_RADIUS_METERS=100000
CORS_ORIGINS=

# Notificaciones push (Expo). El token, si hace falta, SOLO aquí: jamás en la app móvil.
PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=
ALERT_COOLDOWN_MINUTES=360
