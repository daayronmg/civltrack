{
  "name": "@gasgo/api",
  "version": "1.0.0",
  "description": "Backend de GASGO: ingesta de la fuente oficial, validación, histórico y API pública.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "migrate": "node --experimental-strip-types src/cli/migrate.ts",
    "ingest": "node --experimental-strip-types src/cli/ingest.ts",
    "alerts": "node --experimental-strip-types src/cli/run-alerts.ts",
    "verify:source": "node --experimental-strip-types src/cli/verify-source.ts",
    "test": "vitest run",
    "pretest": "npm run build -w @gasgo/core"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@gasgo/core": "*",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
